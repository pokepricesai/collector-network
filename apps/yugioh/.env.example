# Yu-Gi-Oh app environment variables
# Copy to .env.local for local development. Never commit .env.local.

# --- Public site metadata ---
# Single source of the production origin. Every canonical URL, OpenGraph
# URL, JSON-LD graph, sitemap entry, sitemap-index and robots.txt
# sitemap directive resolves through this value via
# apps/yugioh/src/lib/site-url.ts.
#
# Fallback when unset: https://duelistprices.example — deliberately
# an unreachable *.example so a misconfigured deploy is obvious rather
# than silently pointing at the wrong domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Supabase (shared network database, server-only anon SELECT) ---
# Use anon key only. Service role must NOT be added unless a specific
# server-side write path justifies it.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# --- Dev-only surfaces ---
# Server-only flag. Set to "1" to expose /dev/design-system in local
# development. Never set this in production without a reason — the
# route noindexes and 404s when this is not "1". Not prefixed with
# NEXT_PUBLIC_ so it never enters the client bundle.
YGO_DEV_TOOLS="0"
