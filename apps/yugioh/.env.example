# Yu-Gi-Oh app environment variables
# Copy to .env.local for local development. Never commit .env.local.

# --- Public site metadata ---
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# --- Supabase (shared network database, server-only anon SELECT) ---
# Use anon key only. Service role must NOT be added unless a specific
# server-side write path justifies it.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# --- Dev-only surfaces ---
# Set to "1" to expose /dev/design-system in local development. Never
# set this in production without a reason — the route intentionally
# noindexes and 404s when this is not "1".
NEXT_PUBLIC_YGO_DEV_TOOLS="0"
