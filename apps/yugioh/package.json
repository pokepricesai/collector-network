{
  "name": "@collector-network/yugioh",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "audit:blue-eyes": "node --env-file=.env.local --import tsx scripts/audit-blue-eyes.mts",
    "audit:homepage": "node --env-file=.env.local --import tsx scripts/audit-homepage.mts",
    "audit:routes": "node --env-file=.env.local --import tsx scripts/verify-slice-6.mts",
    "audit:browse": "node --env-file=.env.local --import tsx scripts/verify-slice-7.mts",
    "audit:market": "node --env-file=.env.local --import tsx scripts/verify-slice-8.mts",
    "bench": "node --import tsx scripts/perf-benchmark.mts",
    "test": "node --import tsx --test src/lib/rarity.test.ts src/lib/edition-badge.test.ts src/lib/fnl.test.ts src/lib/search-parsing.test.ts src/lib/slug.test.ts src/server/history.test.ts src/lib/finder-filters.test.ts",
    "clean": "rimraf .next .turbo node_modules"
  },
  "dependencies": {
    "@collector-network/database": "workspace:*",
    "@collector-network/market-data": "workspace:*",
    "@collector-network/network-config": "workspace:*",
    "next": "^15.1.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
