{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.ygoprices.io" }],
      "destination": "https://ygoprices.io/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/prewarm",
      "schedule": "5 * * * *"
    }
  ]
}
