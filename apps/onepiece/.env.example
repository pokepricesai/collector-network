# One Piece app environment variables
# Copy to .env.local for local development. Never commit .env.local.

# --- Public site metadata ---
# Single source of the production origin. Every canonical URL, OpenGraph
# URL, JSON-LD graph, sitemap entry, sitemap-index and robots.txt
# sitemap directive resolves through this value via
# apps/onepiece/src/lib/site-url.ts.
NEXT_PUBLIC_SITE_URL="http://localhost:3002"

# --- Supabase (shared network database, server-only anon SELECT) ---
# Use anon key only. Service role must NOT be added unless a specific
# server-side write path justifies it.
# Same shared project as Yu-Gi-Oh, MTGPrices and PokePrices — every OP
# read goes through @collector-network/database which honours these two.
# SUPABASE_URL=""
# SUPABASE_ANON_KEY=""

# --- Site launch gate ---
# "true" flips per-page robots to index/follow and turns on the
# sitemap directive in robots.txt. Any other value keeps the site
# noindex + nofollow — safe default for pre-launch previews.
SITE_LAUNCHED="false"

# --- IndexNow (Bing / Yandex / Naver push-notification) ---
# When both are set, the submitIndexNow() helper at
# apps/onepiece/src/lib/indexnow.ts will POST canonical URLs to
# api.indexnow.org whenever we invoke it. Leave INDEXNOW_ENABLED unset
# or false to keep the helper a no-op.
# INDEXNOW_ENABLED="true"
# INDEXNOW_KEY=""

# --- Analytics ---
# Vercel Web Analytics is auto-wired in src/app/layout.tsx via
# @vercel/analytics/next. No env var is needed. If we add Google
# Analytics 4 later, set NEXT_PUBLIC_GA_ID here and mount the loader.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
